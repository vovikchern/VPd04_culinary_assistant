# Скопируйте этот файл в .env и впишите свой ключ
# Ключ получается бесплатно на https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=ваш_ключ_здесь

# Email для MyMemory (повышает дневной лимит перевода с 5000 до 50000 символов)
# Регистрация НЕ нужна — просто любой ваш email в качестве параметра
MYMEMORY_EMAIL=ваш_email@example.com

# (Необязательно) Резервный переводчик Google при недоступности MyMemory.
# По умолчанию в коде включён (true) — строку можно не указывать вовсе.
# MYMEMORY_USE_FALLBACK=false

# Токен бота ВКонтакте
# Получение: сообщество → Управление → Настройки → Работа с API →
# Создать ключ (права: Сообщения сообщества + Фотографии)
# Там же включить Long Poll API и разрешить событие «Входящие сообщения»
VK_BOT_TOKEN=ваш_токен_здесь
